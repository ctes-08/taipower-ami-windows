{
  "manifest_version": 3,
  "name": "台電 AMI 交接至 Home Assistant（V2）",
  "version": "2.0.1",
  "description": "在正常登入台電後，將最小 AMI 授權安全交給本機 Home Assistant。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "activeTab",
    "cookies",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://service.taipower.com.tw/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "更新台電 AMI 授權",
    "default_popup": "popup.html"
  }
}
